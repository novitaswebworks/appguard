{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AppGuard",
  "version": "0.5.2",
  "identifier": "com.appguard.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AppGuard",
        "width": 960,
        "height": 680,
        "minWidth": 800,
        "minHeight": 560
      },
      {
        "label": "auth",
        "title": "AppGuard Verification",
        "width": 380,
        "height": 330,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./entitlements.plist"
    }
  }
}
